# DUMAL-NEXT: Environment Variables
# Official Vercel Production Domains & Supabase Configuration

# Supabase REST / Auth Configuration (Port 443 via HTTPS)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Supabase PostgreSQL Connection Pooler (Supavisor)
# Port 6543: Transaction Mode (Recommended for Serverless / Vercel Production to prevent connection pool exhaustion and 502 Bad Gateway)
DATABASE_URL=postgresql://postgres.your-project-ref:[YOUR-DATABASE-PASSWORD]@aws-0-[YOUR-REGION].pooler.supabase.com:6543/postgres?pgbouncer=true

# Port 5432: Direct Connection (Used exclusively for CLI schema migrations and direct administrative access)
DIRECT_URL=postgresql://postgres:[YOUR-DATABASE-PASSWORD]@db.your-project-ref.supabase.co:5432/postgres

# Production Vercel Domains
NEXT_PUBLIC_APP_URL=https://dumalnext-student.vercel.app
NEXT_PUBLIC_STUDENT_URL=https://dumalnext-student.vercel.app
NEXT_PUBLIC_ADMIN_URL=https://dumalnext-admin.vercel.app
NEXT_PUBLIC_TEACHER_URL=https://dumalnext-teacher.vercel.app
NEXT_PUBLIC_ITSUPPORT_URL=https://dumalnext-itsupport.vercel.app
