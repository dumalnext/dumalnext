{
  "name": "dumalnext",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "dev:student": "npm run dev --workspace=@dumalnext/student",
    "build:student": "npm run build --workspace=@dumalnext/student",
    "dev:teacher": "npm run dev --workspace=@dumalnext/teacher",
    "build:teacher": "npm run build --workspace=@dumalnext/teacher",
    "dev:admin": "npm run dev --workspace=@dumalnext/admin",
    "build:admin": "npm run build --workspace=@dumalnext/admin",
    "dev:it": "npm run dev --workspace=@dumalnext/it-support",
    "build:it": "npm run build --workspace=@dumalnext/it-support"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.116.0",
    "next": "16.3.5",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
